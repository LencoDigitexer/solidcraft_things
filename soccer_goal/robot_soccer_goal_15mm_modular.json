    {
      "command": "construct.plane.offset",
      "params": {
        "base": "YZ",
        "offset": "-width / 2",
        "name": "LeftFramePlane"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "LeftFramePlane",
        "name": "LeftSideFrameSketch"
      }
    },
    {
      "command": "sketch.line",
      "params": {
        "points": [
          [0, 0],
          ["depth", "0 * bar"],
          ["depth", "bar"],
          ["top_depth", "height"],
          ["0 * bar", "height"]
        ],
        "closed": true,
        "infer": true
      }
    },
    {
      "command": "sketch.line",
      "params": {
        "points": [
          ["bar", "bar"],
          ["depth - 1.298 * bar", "bar"],
          ["top_depth - 1.298 * bar + (depth - top_depth) * bar / (height - bar)", "height - bar"],
          ["bar", "height - bar"]
        ],
        "closed": true,
        "infer": true
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
